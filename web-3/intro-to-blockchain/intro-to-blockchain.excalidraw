    {
      "id": "_L3-wTqm1bEFXvdsc2xAx",
      "type": "text",
      "x": 342.3515625,
      "y": 320.07421875,
      "width": 991.1393432617188,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
