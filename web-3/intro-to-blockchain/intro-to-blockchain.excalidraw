      "groupIds": [],
      "frameId": null,
      "index": "aJ",
      "roundness": null,
      "seed": 610108721,
      "version": 75,
      "versionNonce": 260853073,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776771631796,
      "link": null,
      "locked": false,
      "text": "Banks dont have your money. They lend out most of it.\nIf there is a bank run (everyone goes to the bank to withdraw their money),banks wont be able to pay everyone\n\nSilicon valley collapsed in 2022. Most YC companies had their funds in SVB. \nThey were bailed out, but if not, you would've seen a lot of startups die.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Banks dont have your money. They lend out most of it.\nIf there is a bank run (everyone goes to the bank to withdraw their money),banks wont be able to pay everyone\n\nSilicon valley collapsed in 2022. Most YC companies had their funds in SVB. \nThey were bailed out, but if not, you would've seen a lot of startups die.",
      "autoResize": true,
      "lineHeight": 1.25
    },
