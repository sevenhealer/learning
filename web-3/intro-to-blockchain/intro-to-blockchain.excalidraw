    {
      "id": "2LdcKTXG6n0m1U11j1Nbp",
      "type": "text",
      "x": 319,
      "y": 2453.5,
      "width": 1179.5791015625,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aV",
      "roundness": null,
      "seed": 1387261265,
      "version": 39,
      "versionNonce": 171300095,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776772392066,
      "link": null,
      "locked": false,
      "text": "Right now, currencies can only be issued by central governments. You can't create your own corn and ask users to use it.\nEven I do issue a Random coin, no one would use it, and for good reasons -\n1. I can print any number of Random coins, making myself richer\n2. I become the central mint and verification athority for the coin.\n3. No one would (or should) trust me",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Right now, currencies can only be issued by central governments. You can't create your own corn and ask users to use it.\nEven I do issue a Random coin, no one would use it, and for good reasons -\n1. I can print any number of Random coins, making myself richer\n2. I become the central mint and verification athority for the coin.\n3. No one would (or should) trust me",
      "autoResize": true,
      "lineHeight": 1.25
    },
