      "isDeleted": false,
      "boundElements": null,
      "updated": 1776771355699,
      "link": null,
      "locked": false,
      "text": "The 2008 Financial crisis was triggered by a financial instrument called mortgage-backed securities.\nEven though the banks at Wall Street were at fault, the government ended up bailing them out using Taxpayer money.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The 2008 Financial crisis was triggered by a financial instrument called mortgage-backed securities.\nEven though the banks at Wall Street were at fault, the government ended up bailing them out using Taxpayer money.",
      "autoResize": true,
      "lineHeight": 1.25
    },
