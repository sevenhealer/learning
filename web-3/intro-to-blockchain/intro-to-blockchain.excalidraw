      "index": "a5",
      "roundness": null,
      "seed": 30550353,
      "version": 98,
      "versionNonce": 1690171857,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776771153576,
      "link": null,
      "locked": false,
      "text": "Inflating Currency: Government has been printing currencies left right and center.\nThis leads to increasing inflation, price of everything goes up.\nHolding on to cash is a losers bet in the long run. Holding on to any asset (Gold, Stock, real estate) \nis better compared to currencies like USD,",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Inflating Currency: Government has been printing currencies left right and center.\nThis leads to increasing inflation, price of everything goes up.\nHolding on to cash is a losers bet in the long run. Holding on to any asset (Gold, Stock, real estate) \nis better compared to currencies like USD,",
      "autoResize": true,
      "lineHeight": 1.25
    },
