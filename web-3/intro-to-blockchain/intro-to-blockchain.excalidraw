    {
      "id": "eSV3tLdxGrUmdRiremmrp",
      "type": "text",
      "x": 344,
      "y": 3767.5,
      "width": 808.559326171875,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0K",
      "roundness": null,
      "seed": 1971801873,
      "version": 4,
      "versionNonce": 1825034641,
      "isDeleted": false,
      "boundElements": [
        {
          "id": "ihMukfC-An4Pp4mxjNpKd",
          "type": "arrow"
        }
      ],
      "updated": 1776794348803,
      "link": null,
      "locked": false,
      "text": "function findHashWithPrefix(prefix){\n    let n = 0;\n    while(1){\n        currentHash = crypto.createHash('sha256').update(n.toString()).digest('hex')\n        if(currentHash.startsWith(prefix)){\n            return {input: n, hash: currentHash}\n        }\n        n++;\n    }\n}\n\nconst result = findHashWithPrefix('000000')\nconsole.log(`Hash of ${result.input} is ${result.hash}`)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function findHashWithPrefix(prefix){\n    let n = 0;\n    while(1){\n        currentHash = crypto.createHash('sha256').update(n.toString()).digest('hex')\n        if(currentHash.startsWith(prefix)){\n            return {input: n, hash: currentHash}\n        }\n        n++;\n    }\n}\n\nconst result = findHashWithPrefix('000000')\nconsole.log(`Hash of ${result.input} is ${result.hash}`)",
      "autoResize": true,
      "lineHeight": 1.25
    },
