    {
      "id": "0ezSj942lfolgUK5TEy2h",
      "type": "text",
      "x": 330.05078125,
      "y": 1032.0390625,
      "width": 1098.4193115234375,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
