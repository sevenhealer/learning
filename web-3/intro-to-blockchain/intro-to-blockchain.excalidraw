    {
      "id": "146PXzCPFSGQ3YATyh_Nq",
      "type": "text",
      "x": 344,
      "y": 3046.09765625,
      "width": 1404.81884765625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aw",
      "roundness": null,
      "seed": 1803789105,
      "version": 29,
      "versionNonce": 930941087,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1776773262639,
      "link": null,
      "locked": false,
      "text": "Hashing is a process that transforms input data (of any size) into a fixed-size string of characters.\nHash functions have several important properties:\n1. Deterministic: The same input will always produce the same output.\n2. Fast computation: The hash value can be quickly computed for any given data.\n3. Pre-image resistance: It should be computationally infeasible to reverse the hash function (i.e., find the original input given its hash output).\n4. Small changes in input produce large changes in output: Even a tiny change in the input should drastically change the hash output.\n5. Collision resistance: It should be computationally infeasible to find two different inputs that produce the same hash output",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Hashing is a process that transforms input data (of any size) into a fixed-size string of characters.\nHash functions have several important properties:\n1. Deterministic: The same input will always produce the same output.\n2. Fast computation: The hash value can be quickly computed for any given data.\n3. Pre-image resistance: It should be computationally infeasible to reverse the hash function (i.e., find the original input given its hash output).\n4. Small changes in input produce large changes in output: Even a tiny change in the input should drastically change the hash output.\n5. Collision resistance: It should be computationally infeasible to find two different inputs that produce the same hash output",
      "autoResize": true,
      "lineHeight": 1.25
    },
