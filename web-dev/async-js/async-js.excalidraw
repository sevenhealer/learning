      "updated": 1776672046799,
      "link": null,
      "locked": false,
      "text": "function setTimeoutSync(cb, timeout){\n    let startTime = new Date();\n    while(1){\n        let currentTime = new Date();\n        if(currentTime.getTime() - startTime.getTime() > timeout){\n            break;\n        }\n    }\n    cb()\n}\n\nsetTimeoutSync(()=>{\n    console.log(\"From setTimeoutSync\")\n}, 6000)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function setTimeoutSync(cb, timeout){\n    let startTime = new Date();\n    while(1){\n        let currentTime = new Date();\n        if(currentTime.getTime() - startTime.getTime() > timeout){\n            break;\n        }\n    }\n    cb()\n}\n\nsetTimeoutSync(()=>{\n    console.log(\"From setTimeoutSync\")\n}, 6000)",
      "autoResize": true,
      "lineHeight": 1.25
    },
