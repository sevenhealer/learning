      "updated": 1776767131552,
      "link": null,
      "locked": false,
      "text": "class Promise2{\n    constructor(fun){\n        fun(() => {\n            this.resolve();\n        });\n    }\n    then(resolve){\n        this.resolve = resolve;\n    }\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Promise2{\n    constructor(fun){\n        fun(() => {\n            this.resolve();\n        });\n    }\n    then(resolve){\n        this.resolve = resolve;\n    }\n}",
