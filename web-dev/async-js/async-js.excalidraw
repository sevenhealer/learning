      "updated": 1776767212571,
      "link": null,
      "locked": false,
      "text": "function ownPromisifiedsetTimeout(){\n    return new Promise2((resolve) => {\n        setTimeout(() => {\n            resolve();\n        }, 4000)\n    })\n}\n\nownPromisifiedsetTimeout().then(() => {\n    console.log(\"Own Promise Called\")\n})",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function ownPromisifiedsetTimeout(){\n    return new Promise2((resolve) => {\n        setTimeout(() => {\n            resolve();\n        }, 4000)\n    })\n}\n\nownPromisifiedsetTimeout().then(() => {\n    console.log(\"Own Promise Called\")\n})",
      "autoResize": true,
      "lineHeight": 1.25
    },
