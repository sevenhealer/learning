      "versionNonce": 1897573287,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1776750899191,
      "link": null,
      "locked": false,
      "text": "function simplifiedPromise(){\n    const p = new Promise(function(resolve){\n        setTimeout(function(){\n            resolve();\n        }, 3000)\n    })\n    return p;\n}\n\nconsole.log(simplifiedPromise())\n\nsimplifiedPromise().then(function(){\n    console.log(\"After 3sec using simplified promise\")\n})",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function simplifiedPromise(){\n    const p = new Promise(function(resolve){\n        setTimeout(function(){\n            resolve();\n        }, 3000)\n    })\n    return p;\n}\n\nconsole.log(simplifiedPromise())\n\nsimplifiedPromise().then(function(){\n    console.log(\"After 3sec using simplified promise\")\n})",
      "autoResize": true,
      "lineHeight": 1.25
    },
