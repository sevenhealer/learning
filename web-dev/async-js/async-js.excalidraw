    {
      "id": "1gSN5AZMO7rW8E_2_ax-t",
      "type": "text",
      "x": 344.50390625,
      "y": 2895.0126953125,
      "width": 417.5597229003906,
      "height": 425,
      "angle": 0,
      "strokeColor": "#1e1e1e",
