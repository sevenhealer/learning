      "boundElements": [],
      "updated": 1776682232683,
      "link": null,
      "locked": false,
      "text": "class Rectrangle{\n    constructor(length, breadth, color){\n        this.length = length\n        this.breadth = breadth\n        this.color = color\n    }\n    area(){\n        return this.length*this.breadth\n    }\n    print(){\n        console.log(\"Color is: \" + this.color)\n    }\n}\n\nconst rect = new Rectrangle(10, 20, \"blue\")\nconsole.log(rect.area())\nrect.print()",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Rectrangle{\n    constructor(length, breadth, color){\n        this.length = length\n        this.breadth = breadth\n        this.color = color\n    }\n    area(){\n        return this.length*this.breadth\n    }\n    print(){\n        console.log(\"Color is: \" + this.color)\n    }\n}\n\nconst rect = new Rectrangle(10, 20, \"blue\")\nconsole.log(rect.area())\nrect.print()",
      "autoResize": true,
      "lineHeight": 1.25
    },
