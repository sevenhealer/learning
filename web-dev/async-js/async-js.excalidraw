      "link": null,
      "locked": false,
      "text": "function setTimeoutPromisified(ms){\n    return new Promise(resolve => setTimeout(resolve, ms))\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "function setTimeoutPromisified(ms){\n    return new Promise(resolve => setTimeout(resolve, ms))\n}",
